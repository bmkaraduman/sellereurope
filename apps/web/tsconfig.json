{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true, "jsx": "preserve", "allowJs": true, "incremental": true, "isolatedModules": true,
    "lib": ["dom", "dom.iterable", "esnext"], "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }], "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
