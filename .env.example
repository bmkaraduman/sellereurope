# ---- Database ----
DATABASE_URL="postgresql://sellereurope:sellereurope@localhost:5432/sellereurope"

# ---- API server ----
API_PORT=4000
# Shared secret the extension and dashboard send as "Authorization: Bearer <token>"
API_TOKEN="change-me"

# ---- Amazon SP-API (Login With Amazon credentials from Seller Central > Develop Apps) ----
SP_API_CLIENT_ID="amzn1.application-oa2-client.xxxxxxxx"
SP_API_CLIENT_SECRET="xxxxxxxx"
# Refresh token obtained by self-authorizing your app on your seller account
SP_API_REFRESH_TOKEN="Atzr|xxxxxxxx"
# EU region endpoint (covers DE, FR, IT, ES, NL, SE, PL, BE, IE, UK)
SP_API_ENDPOINT="https://sellingpartnerapi-eu.amazon.com"
# Your seller id (Seller Central > Account Info > Merchant Token)
SP_API_SELLER_ID="AXXXXXXXXXXXXX"

# ---- Business rules (defaults, can be overridden per store in the dashboard) ----
MIN_PROFIT_EUR=3
MIN_MARGIN_PERCENT=15
