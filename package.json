{
  "name": "sellereurope",
  "private": true,
  "version": "0.1.0",
  "description": "EU-internal Amazon-to-Amazon arbitrage / dropshipping toolkit (extension + API + dashboard)",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @sellereurope/api dev",
    "dev:web": "pnpm --filter @sellereurope/web dev",
    "build:extension": "pnpm --filter @sellereurope/extension build",
    "db:migrate": "pnpm --filter @sellereurope/api prisma migrate dev",
    "db:generate": "pnpm --filter @sellereurope/api prisma generate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
